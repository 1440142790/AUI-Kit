{
  "name": "aui-kit",
  "version": "0.1.0-alpha",
  "description": "AI-optimized Universal UI Kit - 跨框架、跨端 UI 组件体系，让 AI 编程工具为任意框架生成一致界面",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aui-kit/aui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/aui-kit/aui-kit/issues"
  },
  "homepage": "https://aui-kit.github.io/aui-kit",
  "keywords": [
    "ui",
    "components",
    "react",
    "vue",
    "tailwind",
    "tailwindcss",
    "ai",
    "aui",
    "aui-kit",
    "universal",
    "cross-platform",
    "typescript"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "build:docs": "npm run build -w @aui/docs",
    "dev": "npm run dev -ws --if-present",
    "dev:docs": "npm run dev -w @aui/docs",
    "clean": "npm run clean -ws --if-present && rm -rf node_modules",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "preview": "npm run preview -w @aui/react-demo -w @aui/vue-demo"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0"
  }
}
