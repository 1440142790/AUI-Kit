{
  "name": "aui-kit",
  "version": "0.1.0-alpha",
  "description": "AI-optimized Universal UI Kit - 跨框架、跨端 UI 组件体系，让 AI 编程工具为任意框架生成一致界面",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aui-kit/aui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/aui-kit/aui-kit/issues"
  },
  "homepage": "https://aui-kit.github.io/aui-kit",
  "keywords": [
    "ui",
    "components",
    "react",
    "vue",
    "tailwind",
    "tailwindcss",
    "ai",
    "aui",
    "aui-kit",
    "universal",
    "cross-platform",
    "typescript"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "build:docs": "pnpm --filter @aui/docs run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:docs": "pnpm --filter @aui/docs run dev",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "preview": "pnpm --filter @aui/react-demo --filter @aui/vue-demo run dev"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0"
  }
}
